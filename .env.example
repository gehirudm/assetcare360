# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=assetcare360
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
# DB_SSL_CA=         # Path to SSL certificate (e.g. .cert/globalsignrootca.pem) — required for remote/SkySQL

# JWT
JWT_SECRET=change-me-to-a-strong-secret

# Application
APP_ENV=local
COOKIE_SECURE=false

# Event Pipeline (RabbitMQ)
EVENTS_ENABLED=false
EVENTS_SCHEMA_VERSION=1.0
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=events
RABBITMQ_EXCHANGE_TYPE=topic
RABBITMQ_AUDIT_QUEUE=audit_queue
RABBITMQ_NOTIFICATION_QUEUE=notification_queue
RABBITMQ_DLX_EXCHANGE=events.dlx
RABBITMQ_DLQ_PREFIX=events.dlq
